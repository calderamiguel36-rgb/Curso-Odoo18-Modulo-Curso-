<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="report_DateReportExternalayout" model="ir.actions.report">
        <field name="name">Date External Report</field>
        <field name="model">covid__crud.date.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">covid__crud.datesReportExternalayout</field>
        <field name="report_file">covid__crud.datesReportExternalayout</field>
        <field name="binding_model_id" eval="False"/> <field name="binding_type">report</field>
    </record>

    <template id="datesReportExternalayout">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page" style="font-size: 18px;">
                    <div class="row">
                        <div class="col-12 text-center"> <h2>Reporte COVID-19</h2>
                            <h4>
                                De: <span t-esc="start_date"/> 
                                Hasta: <span t-esc="end_date"/>
                            </h4>
                            
                            <table class="table table-sm mt-4">
                                <thead class="table-dark">
                                    <tr>
                                        <th scope="col">Source</th>
                                        <th scope="col">Country</th>
                                        <th scope="col">Infected</th>
                                        <th scope="col">Recovered</th>
                                        <th scope="col">Deceased</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="CovidRecords" t-as="record">
                                        <tr>
                                            <td><t t-esc="record['source']"/></td>
                                            <td><t t-esc="record['country_id'][1]"/></td>
                                            <td><t t-esc="record['infected']"/></td>
                                            <td><t t-esc="record['recovered']"/></td>
                                            <td><t t-esc="record['deceased']"/></td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>